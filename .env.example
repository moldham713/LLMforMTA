# Copy to .env (`make up` does this for you on first run).

# Postgres (db service)
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit
POSTGRES_DB=transit

# Backend (api + worker)
DATABASE_URL=postgresql+psycopg://transit:transit@db:5432/transit
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
WORKER_HEARTBEAT_SECONDS=15

# LLM (not used until the chat phase)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Host port for the web UI
WEB_PORT=8080
