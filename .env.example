# Copy to .env (`make up` does this for you on first run).

# Postgres (db service)
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit
POSTGRES_DB=transit

# Backend (api + worker)
DATABASE_URL=postgresql+psycopg://transit:transit@db:5432/transit
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
# Worker healthcheck fails when no poll cycle has completed for this long.
WORKER_MAX_CYCLE_AGE_SECONDS=120

# Static data (defaults shown). GTFS_REFRESH_HOURS=0 disables the worker refresh.
GTFS_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_supplemented.zip
STATIONS_URL=https://data.ny.gov/api/views/39hk-dx4f/rows.csv?accessType=DOWNLOAD
GTFS_REFRESH_HOURS=6

# Realtime. Override one feed with RT_FEED_URL_<FEED>, e.g. RT_FEED_URL_ACE or
# RT_FEED_URL_ALERTS (feeds: 1234567 ace bdfm g jz nqrw l si alerts).
RT_POLL_SECONDS=30
RT_TIMEOUT_SECONDS=10
# Feeds older than this are reported stale by /api/health and /api/departures.
RT_STALE_SECONDS=90
# Arrivals from a feed that stops updating expire after this long.
RT_TTL_SECONDS=180
# Search drops candidates scoring below this fraction of the best match.
SEARCH_RELATIVE_CUTOFF=0.6

# Integration tests (make test-integration). Tests drop and recreate its schemas.
TEST_DATABASE_URL=postgresql+psycopg://transit:transit@db:5432/transit_test
TEST_REDIS_URL=redis://redis:6379/15

# LLM (not used until the chat phase)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Host port for the web UI
WEB_PORT=8080
